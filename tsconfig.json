{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@lz19.02/finwork-kit/chat/core-sse": ["./src/chat/core-sse/index.ts"],
      "@lz19.02/finwork-kit/chat/core-detail": ["./src/chat/core-detail/index.ts"],
      "@lz19.02/finwork-kit/chat/ui": ["./src/chat/ui/index.ts"]
    }
  },
  "include": ["src", "docs", "config", "vite.lib.config.ts", ".dumirc.ts"],
  "exclude": ["node_modules", "dist", "site-dist", ".dumi"]
}
