{
  "name": "@lz19.02/finwork-kit",
  "version": "0.1.0",
  "description": "Reusable FinWork capabilities",
  "type": "module",
  "packageManager": "pnpm@8.12.1",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "chat/ui": [
        "dist/types/chat/ui/index.d.ts"
      ],
      "chat/core-sse": [
        "dist/types/chat/core-sse/index.d.ts"
      ],
      "chat/core-detail": [
        "dist/types/chat/core-detail/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./chat/core-sse": {
      "types": "./dist/types/chat/core-sse/index.d.ts",
      "import": "./dist/chat/core-sse.js"
    },
    "./chat/core-detail": {
      "types": "./dist/types/chat/core-detail/index.d.ts",
      "import": "./dist/chat/core-detail.js"
    },
    "./chat/ui": {
      "types": "./dist/types/chat/ui/index.d.ts",
      "import": "./dist/chat/ui.js"
    },
    "./chat/style.css": "./dist/chat-ui.css"
  },
  "scripts": {
    "dev": "pnpm docs:dev",
    "build": "pnpm build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "docs:dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:preview": "vite preview --outDir site-dist --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm build:lib && pnpm verify:exports && pnpm verify:consumer",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm build:lib"
  },
  "dependencies": {
    "@ant-design/icons": "4.8.3",
    "ahooks": "3.9.7",
    "antd": "4.24.8",
    "highlight.js": "11.11.1",
    "highlightjs-vue": "1.0.0",
    "markdown-to-jsx": "8.0.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "pnpm": {
    "overrides": {
      "umi": "4.4.11",
      "@umijs/bundler-vite>vite@4": "6.4.3",
      "@umijs/bundler-vite>@vitejs/plugin-react@4.0.0": "4.3.4"
    }
  },
  "devDependencies": {
    "@dicebear/core": "9.2.3",
    "@dicebear/lorelei": "9.2.3",
    "@types/node": "22.12.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "dumi": "2.4.21",
    "happy-dom": "20.3.7",
    "less": "4.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
