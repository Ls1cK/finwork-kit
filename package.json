{
  "name": "finwork-kit",
  "version": "0.0.1",
  "description": "Reusable FinWork capabilities",
  "type": "module",
  "packageManager": "pnpm@8.12.1",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    "./chat/core-sse": {
      "types": "./dist/types/chat/core-sse/index.d.ts",
      "import": "./dist/chat/core-sse.js"
    },
    "./chat/core-detail": {
      "types": "./dist/types/chat/core-detail/index.d.ts",
      "import": "./dist/chat/core-detail.js"
    },
    "./chat/ui": {
      "types": "./dist/types/chat/ui/index.d.ts",
      "import": "./dist/chat/ui.js"
    },
    "./chat/style.css": "./dist/chat-ui.css"
  },
  "scripts": {
    "dev": "pnpm demo:dev",
    "build": "pnpm build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "pnpm build:lib && vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "docs:dev": "dumi dev",
    "docs:build": "pnpm build:lib && dumi build",
    "docs:preview": "vite preview --outDir site-dist --port 4174",
    "typecheck": "tsc --noEmit",
    "verify:exports": "node scripts/verify-exports.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm build:lib"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "dumi": "2.4.21",
    "less": "4.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
